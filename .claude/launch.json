{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "histology-lab-os",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "dermpath-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "E2E_API_PORT=8000",
        "E2E_WEB_PORT=3600",
        "node",
        "workbench/web/tests/e2e/start-backend.mjs"
      ],
      "port": 8000
    },
    {
      "name": "dermpath-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "workbench/web",
        "run",
        "dev"
      ],
      "port": 3600
    }
  ]
}
